{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Comfort Home PG - Rooms Data",
  "type": "object",
  "required": ["rooms"],
  "properties": {
    "rooms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "ac", "price_per_person", "available", "features"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "type": {
            "type": "string",
            "enum": ["Single Occupancy", "Double Sharing", "Triple Sharing"]
          },
          "ac": {
            "type": "boolean"
          },
          "price_per_person": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 50000
          },
          "available": {
            "type": "boolean"
          },
          "features": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
